[Unit]
Description=Postiz Temporal Dev Server (System)
After=network.target

[Service]
Type=simple
User=lbx
WorkingDirectory=/home/lbx/postiz-app
ExecStart=/home/lbx/.local/bin/temporal server start-dev --ip 127.0.0.1 --port 7233 --ui-ip 127.0.0.1 --ui-port 8080 --db-filename /home/lbx/postiz-app/.runtime/temporal/temporal-dev.db
Restart=always
RestartSec=2
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
